{
  "name": "moltalk",
  "version": "0.1.60",
  "description": "디시인사이드를 메신저 화면으로 보는 비공식 열람 앱",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "node tools/build.mjs",
    "start": "node tools/build.mjs && electron .",
    "build:exe": "node tools/build.mjs && electron-builder --win nsis",
    "build:mac": "node tools/build.mjs && electron-builder --mac dir --universal -c.productName=MolTalk",
    "build:apk": "node android/build-apk.mjs"
  },
  "build": {
    "appId": "io.github.moltalk",
    "productName": "몰톡",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "app/**",
      "desktop/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "MolTalk-Setup-${version}.exe"
    },
    "mac": {
      "target": "dir",
      "icon": "build/icon.png",
      "identity": null,
      "extendInfo": {
        "CFBundleDisplayName": "몰톡"
      },
      "category": "public.app-category.social-networking"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "몰톡",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "linkedom": "0.18.14"
  }
}
