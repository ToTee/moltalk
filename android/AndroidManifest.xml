<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.github.moltalk" android:versionCode="1" android:versionName="0.1.0">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <queries><package android:name="io.github.yangjitalk"/></queries>
    <application android:label="몰톡" android:icon="@mipmap/ic_launcher" android:allowBackup="false" android:usesCleartextTraffic="false" android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask" android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 양지톡이 설정을 건넬 때 쓰는 입구. 안드로이드 13부터는 여기 적힌 모양과 맞는 요청만 다른 앱에서 들어올 수 있습니다.
                 요청에 파일 종류가 붙어 올 수도, 안 붙어 올 수도 있어 두 가지를 모두 적습니다. -->
            <intent-filter>
                <action android:name="io.github.moltalk.IMPORT"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content" android:host="io.github.yangjitalk.export"/>
            </intent-filter>
            <intent-filter>
                <action android:name="io.github.moltalk.IMPORT"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content" android:host="io.github.yangjitalk.export" android:mimeType="application/json"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
